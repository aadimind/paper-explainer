{
  "name": "paper-explainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 execute paper-explainer-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute paper-explainer-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "vitest": "*",
    "wrangler": "*"
  }
}
